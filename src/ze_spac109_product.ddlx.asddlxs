@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Product',
  typeNamePlural: 'Products',
  title: { type: #STANDARD, value: 'ProductName' }
}
annotate view ZC_SPAC109_PRODUCT with
{
  @UI.facet: [
    {
      id: 'ProductFacet',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Product',
      position: 10
    },
    {
      id: 'ProductQuickView',
      purpose: #QUICK_VIEW,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Product',
      position: 100
    }
  ]

  @UI.lineItem: [{ position: 10, cssDefault.width: '8em' }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  ProductId;

  @UI.lineItem: [{ position: 20, cssDefault.width: '10em' }]
  @UI.identification: [{ position: 20 }]
  ProductName;

  @UI.lineItem: [{ position: 30, cssDefault.width: '15em' }]
  @UI.identification: [{ position: 30 }]
  ProductDescription;

  @UI.lineItem: [{ position: 40, cssDefault.width: '10em' }]
  @UI.identification: [{ position: 40 }]
  Category;
  
  @UI.lineItem:       [{ position: 50, cssDefault.width: '8em', criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON }]
  @UI.identification: [{ position: 50, criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON }]
  @UI.selectionField: [{ position: 20 }]
  ProductStatus;
  
  @UI.lineItem:       [{ position: 60, cssDefault.width: '8em' }]
  @UI.identification: [{ position: 60 }]
  MinStock;
  
  @UI.lineItem:       [{ position: 70, cssDefault.width: '10em' }]
  @UI.identification: [{ position: 70 }]
  Price;

  @UI.identification: [{ position: 75, cssDefault.width: '8em' }]
  CurrencyCode;
}