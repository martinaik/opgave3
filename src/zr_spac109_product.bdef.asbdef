managed implementation in class zbp_r_spac109_product unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC109_PRODUCT alias Product
persistent table zspac109_product
draft table zdspac109_prod
lock master total etag LastChangedAt
early numbering
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete ( precheck );

  field ( readonly ) ProductId, StatusCriticality;
  field ( mandatory ) ProductName, ProductDescription, Category, ProductStatus;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  validation validateUniqueName on save { create; update; field ProductName; }
  validation validateMandatory on save { create; update; field ProductName, ProductDescription, Category, ProductStatus; }
  validation validatePrice on save { create; update; field Price, CurrencyCode; }

  draft determine action Prepare
  {
    validation validateUniqueName;
    validation validateMandatory;
    validation validatePrice;
  }

  determination setDefaults on modify { create; }

  mapping for zspac109_product
  {
    ProductId          = product_id;
    ProductName        = product_name;
    ProductDescription = product_description;
    Category           = category;
    ProductStatus      = product_status;
    MinStock           = min_stock;
    CurrencyCode       = currency_code;
    Price              = price;
    LastChangedAt      = last_changed_at;
  }
}